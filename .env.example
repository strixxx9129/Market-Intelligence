# Copy to .env and adjust. Never commit .env.
# Values below are for LOCAL DEVELOPMENT ONLY.

# --- App ---
# ENVIRONMENT: dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
# LOG_JSON: true = JSON logs (prod), false = human-readable console logs
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=marketlens
POSTGRES_PASSWORD=marketlens
POSTGRES_DB=marketlens
POSTGRES_PORT=5432
# Host "postgres" is the docker compose service name.
DATABASE_URL=postgresql+asyncpg://marketlens:marketlens@postgres:5432/marketlens
TEST_DATABASE_URL=postgresql+asyncpg://marketlens:marketlens@postgres:5432/marketlens_test

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Object storage: SeaweedFS S3 gateway (S3-compatible; replaces MinIO, see ADR 0002) ---
S3_ACCESS_KEY=marketlens
S3_SECRET_KEY=marketlens-secret
S3_PORT=8333
S3_ENDPOINT_URL=http://seaweedfs:8333

# --- MLflow ---
MLFLOW_PORT=5000
MLFLOW_BUCKET=mlflow
# Bucket for backtest equity curves (Parquet).
BACKTEST_BUCKET=backtests

# --- API auth (generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET=dev-only-change-me-32-bytes-minimum!!

# --- Monitoring (optional) ---
# Discord/Slack-compatible incoming webhook for monitoring alerts; empty = log only.
MONITORING_WEBHOOK_URL=
# Error tracking; empty = disabled.
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=marketlens-grafana
GRAFANA_PORT=3001
# Website dev server (make web); the browser calls the API at VITE_API_URL.
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
PROMETHEUS_PORT=9090

# --- API ---
API_PORT=8000

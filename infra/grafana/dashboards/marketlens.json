{
  "uid": "marketlens-overview",
  "title": "MarketLens overview",
  "tags": [
    "marketlens"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "API",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / s by status",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx ratio",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "429 / s (rate limited)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{status=\"429\"}[5m]))",
          "legendFormat": "429",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Celery",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Task p95 duration",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, task) (rate(celery_task_duration_seconds_bucket[1h])))",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Task outcomes (1 h)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (task, state) (increase(celery_tasks_total[1h]))",
          "legendFormat": "{{task}} {{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Retries (1 h)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (task) (increase(celery_task_retries_total[1h]))",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Data & model health (from monitoring_metrics)",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Freshness: hours since the newest candle closed",
      "description": "Measured from the candle close (ts + 24 h). Above the threshold = ingestion stalled or the source is late.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketlens-db"
          },
          "rawSql": "SELECT ts AS time, value AS \"hours since close\", threshold AS \"alert threshold\" FROM monitoring_metrics WHERE metric_name = 'freshness_hours' AND $__timeFilter(ts) ORDER BY ts",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Feature drift: PSI over time",
      "description": "PSI < 0.10 stable, 0.10-0.25 moderate, > 0.25 major shift vs the model's training data. Investigate, don't auto-retrain.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketlens-db"
          },
          "rawSql": "SELECT ts AS time, replace(metric_name, 'psi:', '') AS metric, value FROM monitoring_metrics WHERE metric_name LIKE 'psi:%' AND value IS NOT NULL AND $__timeFilter(ts) ORDER BY ts",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Latest PSI per input",
      "description": "",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketlens-db"
          },
          "rawSql": "SELECT DISTINCT ON (metric_name) replace(metric_name, 'psi:', '') AS feature, value AS psi FROM monitoring_metrics WHERE metric_name LIKE 'psi:%' AND value IS NOT NULL ORDER BY metric_name, ts DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^psi$/"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Live log loss vs reference",
      "description": "Labels arrive a day late; empty until enough live forecasts have outcomes (n >= 20).",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketlens-db"
          },
          "rawSql": "SELECT ts AS time, metric_name AS metric, value FROM monitoring_metrics WHERE metric_name IN ('log_loss_30d', 'log_loss_90d') AND value IS NOT NULL AND $__timeFilter(ts) ORDER BY ts",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketlens-db"
          },
          "rawSql": "SELECT ts AS time, 'alert threshold' AS metric, threshold AS value FROM monitoring_metrics WHERE metric_name = 'log_loss_30d' AND $__timeFilter(ts) ORDER BY ts",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "type": "table",
      "title": "Recent monitoring alerts",
      "description": "",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "marketlens-db"
          },
          "rawSql": "SELECT created_at AS time, severity, metric_name, status, message FROM monitoring_alerts ORDER BY created_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "description": "API, Celery and data/model health. Educational project; not financial advice."
}